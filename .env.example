# Set your own unique password in Railway. Leaving it unset keeps access locked.
APP_PASSWORD=
NODE_ENV=production
PORT=3000
# Optional exact public origin, e.g. https://your-service.up.railway.app
# Railway's RAILWAY_PUBLIC_DOMAIN is used automatically when available.
APP_ORIGIN=
SOLANA_RPC_URL=
# Pinata API key (JWT) used to upload token images to IPFS. Optional; without it paste a metadata URI.
PINATA_JWT=
# Must support the Jito-Solana simulateBundle method, e.g. QuickNode Lil' JIT.
BUNDLE_SIMULATION_RPC_URL=
JITO_BLOCK_ENGINE_URL=https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_AUTH_UUID=
ENABLE_LAUNCH=false

# Server-only creator wallet. Public addresses alone are rejected.
# Use a base58 private key or a JSON array containing a 64-byte Solana keypair.
# Number more wallets CREATOR_PRIVATE_KEY_2 ... CREATOR_PRIVATE_KEY_50.
# Never put real keys in this file or in GitHub. Add them directly in Railway.
CREATOR_PRIVATE_KEY_1=
CREATOR_LABEL_1=Main creator
