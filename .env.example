# Set your own unique password in Railway. Leaving it unset keeps access locked.
APP_PASSWORD=
NODE_ENV=production
PORT=3000
# Optional exact public origin, e.g. https://your-service.up.railway.app
# Railway's RAILWAY_PUBLIC_DOMAIN is used automatically when available.
APP_ORIGIN=
SOLANA_RPC_URL=
# Must support the Jito-Solana simulateBundle method, e.g. QuickNode Lil' JIT.
BUNDLE_SIMULATION_RPC_URL=
JITO_BLOCK_ENGINE_URL=https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_AUTH_UUID=
ENABLE_LAUNCH=false
